{
  "name": "jobsearch-desktop",
  "productName": "Jobsearch",
  "version": "1.1.0",
  "description": "Jobsearch – dein Bewerbungs-Cockpit",
  "author": "Jobsearch",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.robbdevo.jobsearch",
    "productName": "Jobsearch",
    "directories": { "output": "release" },
    "files": ["main.cjs", "preload.cjs", "icon.png", "dist/**/*"],
    "win": { "target": ["nsis", "portable"], "icon": "icon.png" },
    "nsis": { "oneClick": true, "artifactName": "Jobsearch-Setup-${version}.exe" },
    "portable": { "artifactName": "Jobsearch-Portable-${version}.exe" }
  }
}
